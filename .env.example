# ==============================================================================
# RepoShield — Environment Variables Template
# Copy this file to .env and populate your personal secrets and configuration.
# ==============================================================================

# Application Environment ('development' | 'production')
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# GitHub Integration & Rate Limit Bypass
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (classic or fine-grained)
# Without a token, anonymous requests to GitHub API are limited to 60 requests/hr.
# With a token, rate limit expands to 5,000 requests/hr.
# Permissions required: 'public_repo' or read-only access.
GITHUB_TOKEN=your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# AI Security Assistant Credentials (Optional)
# ------------------------------------------------------------------------------
# Configure either Google Gemini or OpenAI to enable the live generative AI assistant
# for natural-language vulnerability explanations and automated patch risk reviews.
#
# Google Gemini API Key:
GEMINI_API_KEY=your_gemini_api_key_here
#
# OpenAI API Key:
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
# URL pointing to the running RepoShield FastAPI backend service
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Scanner Engine Configuration & Limits
# ------------------------------------------------------------------------------
# Maximum allowable uncompressed repository archive size in megabytes
MAX_SCAN_SIZE_MB=100

# Maximum individual file size in bytes to analyze (10MB default)
MAX_FILE_SIZE_BYTES=10485760

# Maximum execution timeout in seconds per scanning task
MAX_SCAN_TIMEOUT_SECONDS=180

# Ephemeral in-memory scan retention window in seconds (30 minutes)
SCAN_TTL_SECONDS=1800
