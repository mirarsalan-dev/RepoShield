# ==============================================================================
# RepoShield .gitignore
# Excludes dependencies, virtual environments, build artifacts, OS files, and secrets
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
*.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.manifest
*.spec

# Python Distribution & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# Node & Next.js Dependencies & Artifacts
node_modules/
.next/
out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# Environment Files & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks
credentials.json
client_secret*.json
service-account*.json
id_rsa*
id_ed25519*
!*.example
!.env.example

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.settings/
.agents/
.cursor/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Vercel & Turbo Cache
.vercel/
.turbo/

# Databases
*.sqlite
*.sqlite3
*.db

# Temporary & Scratch Files
scratch/
scratch_*
*scratch*
tmp/
temp/
